# File: Dockerfile.runtime
# Build: docker build -f Dockerfile.runtime -t your-public-repo/terachem-runtime:latest .
# Push: docker push your-public-repo/terachem-runtime:latest

FROM nvidia/cuda:12.0.1-runtime-ubuntu22.04

# Install runtime dependencies
RUN apt-get update -y \
 && apt-get install -y \
    openmpi-bin \
    openmpi-common \
    libopenmpi-dev \
 && apt-get clean \
 && rm -rf /var/lib/apt/lists/*

# Copy Terachem binaries from private image (/opt holds the Terachem installation)
COPY --from=code.mps.inc/mps/terachem:eval /opt /opt/terachem

# Set environment variables for Terachem
ENV TERACHEM_INSTALL=/opt/terachem
ENV PATH=$PATH:$TERACHEM_INSTALL/bin
ENV LD_LIBRARY_PATH=$LD_LIBRARY_PATH:$TERACHEM_INSTALL/lib

# Set working directory where jobs will run
WORKDIR /workspace

# Default command to run when starting the container
CMD ["bash"]